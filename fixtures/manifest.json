  "tiers": {
    "smoke": "Small route-diverse set (CR3, ARW, DJI DNG with opcodes, X-Trans RAF, NEF) used by default by tools/fetch-fixtures.ps1 and by fixture-dependent tests.",
    "qualification": "Wider camera/mode matrix from blueprint section 3; fetched explicitly with -Tier qualification or -Tier all."
  },
  "gaps": [
    {
      "target": "DJI Mini 4 Pro (FC8482)",
      "status": "absent",
      "detail": "No sample in the archive; dji-fc7303-dng (Mini 2) is the closest Mini-series camera."
    },
    {
      "target": "Insta360 Ace / Ace Pro / Ace Pro 2 planar DNG",
      "status": "absent",
      "detail": "The only Insta360 (Arashi Vision) sample is the One X dual-lens 360 source (insta360-one-x-dng)."
    },
    {
      "target": "Fujifilm multi-shot / pixel-shift RAF",
      "status": "absent",
      "detail": "No Fujifilm pixel-shift sample in the archive."
    },
    {
      "target": "Pixel-shift / high-resolution composites (Sony ARQ, Pentax, Panasonic, OM System)",
      "status": "deferred",
      "detail": "Available in the archive (40-325 MB each) but excluded from W1 for size; add them when the multi-image route is implemented."
    },
    {
      "target": "Corrupted and truncated files",
      "status": "derived",
      "detail": "Not taken from the archive; tests derive them from cached fixtures at run time."
    },
    {
      "target": "Scene diversity (sunset, blue hour, night sky, fog, snow, high ISO, backlight)",
      "status": "absent",
      "detail": "The archive holds mostly one daylight test shot per camera mode; blueprint section 10 scene coverage needs a separate corpus."
    }
  ],
