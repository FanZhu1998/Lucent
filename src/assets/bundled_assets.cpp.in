// Generated by src/assets/CMakeLists.txt when the build is configured: the bundled assets
// (LUCENT_BUNDLED_ASSETS) and the SHA-256 of each one's manifest.json. Do not edit.

#include <lucent/assets/bundled_assets.hpp>

#include <array>

namespace lucent::assets {

namespace {

constexpr std::array<BundledAsset, @LUCENT_BUNDLED_ASSET_COUNT@> kBundledAssets{{
@LUCENT_BUNDLED_ASSET_ENTRIES@}};

}  // namespace

std::span<const BundledAsset> bundled_assets() noexcept {
    return kBundledAssets;
}

std::optional<core::Digest256> bundled_manifest_pin(std::string_view id) noexcept {
    for (const BundledAsset& asset : kBundledAssets) {
        if (asset.id == id) {
            auto digest = core::digest_from_hex(asset.manifest_sha256);
            if (digest) {
                return *digest;
            }
        }
    }
    return std::nullopt;
}

}  // namespace lucent::assets
