// Windows version resource of Lucent.exe. Generated into the build tree by
// apps/lucent/CMakeLists.txt (configure_file) from the project version.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0x0L
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@LUCENT_RC_COMPANY@"
            VALUE "FileDescription", "@LUCENT_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Lucent"
            VALUE "LegalCopyright", "@LUCENT_RC_COPYRIGHT@"
            VALUE "OriginalFilename", "Lucent.exe"
            VALUE "ProductName", "Lucent"
            VALUE "ProductVersion", "@PROJECT_VERSION@ (@LUCENT_GIT_COMMIT@)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
