# Prepares bin/ of a build tree so that Qt applications run from it (apps/lucent/CMakeLists.txt).
#
#   cmake -DSOURCE_DIR=<vcpkg bin> -DDESTINATION_DIR=<build bin> -DQT_PREFIX=<Qt prefix>
#         -DQT_PLUGINS=<plugins, relative to prefix> -DQT_QML=<QML imports, relative to prefix>
#         -P build_tree_runtime.cmake
#
# 1. Copies every DLL of SOURCE_DIR into DESTINATION_DIR (only when the content differs), so that
#    the dependencies of Qt's plugins and QML modules resolve through the application directory.
# 2. Writes DESTINATION_DIR/qt.conf, which points Qt at the plugins and QML imports of the vcpkg
#    installation. It is written last: its presence means step 1 completed.
#
# Build trees only. The installer deploys with windeployqt (W5) and never ships this qt.conf.

foreach(variable SOURCE_DIR DESTINATION_DIR QT_PREFIX QT_PLUGINS QT_QML)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        message(FATAL_ERROR "build_tree_runtime.cmake: ${variable} is not set")
    endif()
endforeach()

file(MAKE_DIRECTORY "${DESTINATION_DIR}")
file(GLOB dlls "${SOURCE_DIR}/*.dll")
foreach(dll IN LISTS dlls)
    get_filename_component(name "${dll}" NAME)
    file(COPY_FILE "${dll}" "${DESTINATION_DIR}/${name}" ONLY_IF_DIFFERENT)
endforeach()

file(WRITE "${DESTINATION_DIR}/qt.conf"
"; Generated by apps/lucent/cmake/build_tree_runtime.cmake for running from this build tree.
; Do not ship: the installer deploys Qt with windeployqt.
[Paths]
Prefix = ${QT_PREFIX}
Plugins = ${QT_PLUGINS}
QmlImports = ${QT_QML}
")
